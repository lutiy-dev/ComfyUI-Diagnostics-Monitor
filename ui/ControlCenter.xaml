<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Diagnostics Monitor" Height="805" Width="1135" MinWidth="900" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#17191D" Foreground="#E9EDF2"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#22262C"/>
  <SolidColorBrush x:Key="Card" Color="#2A2F35"/>
  <SolidColorBrush x:Key="Line" Color="#373E47"/>
  <SolidColorBrush x:Key="Muted" Color="#A6B1BD"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#333940"/>
   <Setter Property="Foreground" Value="#F2F4F7"/>
   <Setter Property="BorderBrush" Value="#404953"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Padding" Value="15,10"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="8">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#BAC3CB"/>
   <Setter Property="Background" Value="#21252A"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Height" Value="44"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TabItem">
      <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="22,9">
       <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="TabSurface" Property="Background" Value="#3D454E"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#1A1E23"/>
   <Setter Property="Foreground" Value="#E9EDF2"/>
   <Setter Property="BorderBrush" Value="#414A54"/>
   <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#31373E"/>
   <Setter Property="Foreground" Value="#11161C"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#D6DEE6"/>
   <Setter Property="Margin" Value="0,5,0,5"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Window.Resources>
 <Grid Margin="22,16,22,14">
  <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Vertical">
    <TextBlock x:Name="BrandTitle" Text="DIAGNOSTICS MONITOR" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="BrandSubtitle" Text="GPU · CPU · ComfyUI · 3ds Max" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top">
    <Border Background="#303741" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
     <TextBlock x:Name="MachineBadge" Text="HOME" FontSize="12" FontWeight="Bold" Foreground="#F2F4F7"/>
    </Border>
    <Border Background="#293D33" CornerRadius="6" Padding="12,6">
     <TextBlock x:Name="CollectorBadge" Text="СБОР: ОЖИДАНИЕ" Foreground="#7DDCAB" FontSize="12" FontWeight="SemiBold"/>
    </Border>
   </StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
   <TabItem x:Name="MonitorTab" Header="Монитор">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,18,0,10">
      <Grid Margin="0,0,0,14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="OverviewLabel" Text="Обзор системы" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="SourceStatus" Grid.Column="1" Text="COMFYUI: ОФЛАЙН · GPU: ОЖИДАНИЕ" Foreground="#C9A869" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <UniformGrid Columns="4" Margin="0,0,0,14">
       <Border Background="{StaticResource Card}" CornerRadius="11" Margin="0,0,10,0" Padding="15">
        <StackPanel>
         <TextBlock Text="GPU" Foreground="{StaticResource Muted}" FontSize="12"/>
         <TextBlock x:Name="GpuValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
         <ProgressBar x:Name="GpuBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#24BAE8" Background="#434A50" BorderThickness="0"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" CornerRadius="11" Margin="0,0,10,0" Padding="15">
        <StackPanel>
         <TextBlock Text="VRAM" Foreground="{StaticResource Muted}" FontSize="12"/>
         <TextBlock x:Name="VramValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
         <ProgressBar x:Name="VramBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#FFAF3B" Background="#434A50" BorderThickness="0"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" CornerRadius="11" Margin="0,0,10,0" Padding="15">
        <StackPanel>
         <TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="12"/>
         <TextBlock x:Name="CpuValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
         <ProgressBar x:Name="CpuBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#62D99A" Background="#434A50" BorderThickness="0"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" CornerRadius="11" Padding="15">
        <StackPanel>
         <TextBlock Text="RAM" Foreground="{StaticResource Muted}" FontSize="12"/>
         <TextBlock x:Name="RamValue" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
         <ProgressBar x:Name="RamBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="#B38EF3" Background="#434A50" BorderThickness="0"/>
        </StackPanel>
       </Border>
      </UniformGrid>
      <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="16" Margin="0,0,0,14">
       <StackPanel>
        <Grid Margin="0,0,0,9">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="HistoryLabel" Text="История ресурсов" FontSize="15" FontWeight="SemiBold"/>
         <TextBlock x:Name="HistoryHint" Grid.Column="1" Text="Последние 120 записей · GPU / VRAM / CPU / RAM" Foreground="{StaticResource Muted}" FontSize="11"/>
        </Grid>
        <Viewbox Stretch="Fill" Height="165">
         <Canvas Width="940" Height="165" Background="#1D2228">
          <Line X1="0" Y1="40" X2="940" Y2="40" Stroke="#373F49" StrokeThickness="1"/>
          <Line X1="0" Y1="82" X2="940" Y2="82" Stroke="#373F49" StrokeThickness="1"/>
          <Line X1="0" Y1="124" X2="940" Y2="124" Stroke="#373F49" StrokeThickness="1"/>
          <Polyline x:Name="GpuLine" Stroke="#24BAE8" StrokeThickness="2" Points=""/>
          <Polyline x:Name="VramLine" Stroke="#FFAF3B" StrokeThickness="2" Points=""/>
          <Polyline x:Name="CpuLine" Stroke="#62D99A" StrokeThickness="2" Points=""/>
          <Polyline x:Name="RamLine" Stroke="#B38EF3" StrokeThickness="2" Points=""/>
         </Canvas>
        </Viewbox>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <TextBlock Text="● GPU" Foreground="#24BAE8" Margin="0,0,19,0"/>
         <TextBlock Text="● VRAM" Foreground="#FFAF3B" Margin="0,0,19,0"/>
         <TextBlock Text="● CPU" Foreground="#62D99A" Margin="0,0,19,0"/>
         <TextBlock Text="● RAM" Foreground="#B38EF3"/>
        </StackPanel>
       </StackPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="11" Padding="16">
        <StackPanel>
         <TextBlock x:Name="AppsLabel" Text="Приложения" FontWeight="SemiBold" Margin="0,0,0,10"/>
         <TextBlock x:Name="ComfyState" Text="ComfyUI: не подключён" Margin="0,0,0,8"/>
         <TextBlock x:Name="MaxState" Text="3ds Max: не запущен" Margin="0,0,0,8"/>
         <TextBlock x:Name="MemoryDetail" Text="RAM / VRAM: нет данных" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="11" Padding="16">
        <StackPanel>
         <TextBlock x:Name="RecentIncidentsLabel" Text="Последние события" FontWeight="SemiBold" Margin="0,0,0,7"/>
         <ListBox x:Name="IncidentsList" Height="93" Background="#1D2228" BorderThickness="0" Foreground="#D6DEE6" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>
       </Border>
      </Grid>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="GenerationsTab" Header="Генерации">
    <Grid Margin="0,18,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="GenerationTitle" Text="Текущая генерация" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,13"/>
     <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="11" Padding="20" Margin="0,0,0,14">
      <StackPanel>
       <Grid Margin="0,0,0,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="GenerationState" Text="Ожидание ComfyUI" FontSize="18" FontWeight="SemiBold" Foreground="#C6D0D9"/>
        <TextBlock x:Name="GenerationTime" Grid.Column="1" Text="00:00" Foreground="{StaticResource Muted}"/>
       </Grid>
       <TextBlock x:Name="GenerationNode" Text="Активная нода: —" Margin="0,0,0,12"/>
       <ProgressBar x:Name="GenerationBar" Height="9" Minimum="0" Maximum="100" Value="0" Foreground="#F3BC49" Background="#434A50" BorderThickness="0"/>
       <TextBlock x:Name="GenerationProgress" Text="Шаги: —" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"/>
       <TextBlock x:Name="GenerationNote" Text="Прогресс и ETA отображаются только при наличии подтверждённых данных ComfyUI." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
      </StackPanel>
     </Border>
     <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="11" Padding="16">
       <DockPanel>
        <TextBlock x:Name="GenerationHistoryTitle" Text="История событий" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ListBox x:Name="GenerationEvents" Foreground="#D6DEE6" Background="#1B2025" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
       </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="11" Padding="16">
       <StackPanel>
        <TextBlock x:Name="GenerationResultsTitle" Text="Результаты / промпты" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock x:Name="GenerationPrivacy" Text="Приватные промпты и изображения по умолчанию не загружаются и не сохраняются." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,20"/>
        <Button x:Name="OpenComfyButton" Content="Открыть ComfyUI (localhost)" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem x:Name="GpuProcessesTab" Header="GPU-процессы">
    <Grid Margin="0,18,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock x:Name="GpuProcessesTitle" Text="Кто использует видеопамять" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="GpuProcessesSubtitle" Text="Windows WDDM · обновление каждые 5 сек, только при открытой вкладке" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
      </StackPanel>
      <Button x:Name="RefreshGpuProcessesButton" Grid.Column="1" Content="Обновить" VerticalAlignment="Center"/>
     </Grid>
     <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="GpuProcessesStatus" Text="Ожидание данных Windows GPU Process Memory" Foreground="#C9A869" VerticalAlignment="Center" FontSize="13"/>
       <TextBlock x:Name="GpuProcessesUpdated" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="11" Padding="12">
      <DataGrid x:Name="GpuProcessesTable" Background="#20252B" Foreground="#E5EAF0"
       BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
       CanUserDeleteRows="False" CanUserResizeRows="False"
       HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
       HorizontalGridLinesBrush="#333C46" VerticalGridLinesBrush="#333C46"
       RowBackground="#222930" AlternatingRowBackground="#2A3038"
       AlternationCount="2" ColumnHeaderHeight="38" RowHeight="33"
       EnableRowVirtualization="True" SelectionMode="Single">
       <DataGrid.Columns>
        <DataGridTextColumn x:Name="GpuProcessNameColumn" Header="Процесс" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn x:Name="GpuProcessIdColumn" Header="PID" Binding="{Binding Pid}" Width="90"/>
        <DataGridTextColumn x:Name="GpuProcessDedicatedColumn" Header="VRAM, МиБ" Binding="{Binding DedicatedMiB, StringFormat=F1}" Width="140"/>
        <DataGridTextColumn x:Name="GpuProcessSharedColumn" Header="Общая, МиБ" Binding="{Binding SharedMiB, StringFormat=F1}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
     <TextBlock x:Name="GpuProcessesDisclaimer" Grid.Row="3" TextWrapping="Wrap" FontSize="12"
      Foreground="{StaticResource Muted}" Margin="2,12,0,0"
      Text="WDDM: значения по процессам поступают из счётчиков Windows, не из NVIDIA-SMI. Они могут отличаться от общего VRAM и не обязательно суммируются. Нет данных ≠ 0 МиБ."/>
    </Grid>
   </TabItem>
   <TabItem x:Name="EvidenceTab" Header="Диагностика">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,18,0,0">
      <TextBlock x:Name="EvidenceTitle" Text="Центр диагностики" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="20">
       <StackPanel>
        <TextBlock x:Name="EvidenceHint" Text="Локальные отчёты об ошибках, без автоматической отправки данных." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
         <TextBlock x:Name="EvidenceHoursLabel" Text="Период событий (часы)" VerticalAlignment="Center" Margin="0,0,20,0"/>
         <ComboBox x:Name="EvidenceHours" SelectedIndex="1" Width="95">
          <ComboBoxItem Content="3"/><ComboBoxItem Content="6"/><ComboBoxItem Content="12"/><ComboBoxItem Content="24"/>
         </ComboBox>
        </StackPanel>
        <CheckBox x:Name="EvidenceWindows" Content="События Windows / WER" IsChecked="True"/>
        <CheckBox x:Name="EvidenceProcesses" Content="Процессы и память" IsChecked="True"/>
        <CheckBox x:Name="EvidenceStorage" Content="Диски и свободное место" IsChecked="True"/>
        <CheckBox x:Name="EvidenceComfy" Content="ComfyUI API и сигнатуры логов" IsChecked="True"/>
        <CheckBox x:Name="EvidenceRaw" Content="Включить приватный RAW-лог (ручное согласие)" IsChecked="False" Foreground="#F1B968"/>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,13">
         <Button x:Name="CaptureEvidenceButton" Background="#F0B840" Foreground="#14191F" Content="Собрать отчёт"/>
         <Button x:Name="OpenEvidenceButton" Content="Папка отчётов"/>
         <Button x:Name="OpenLogsButton" Content="Папка логов"/>
        </StackPanel>
        <TextBlock x:Name="EvidenceStatus" Text="Ожидание команды" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="SettingsTab" Header="Настройки">
    <StackPanel Margin="0,18,0,0">
     <TextBlock x:Name="SettingsTitle" Text="Настройки приложения" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
     <Border Background="{StaticResource Panel}" CornerRadius="11" Padding="20">
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
        <TextBlock x:Name="LanguageLabel" Text="Язык интерфейса" VerticalAlignment="Center" Width="215"/>
        <ComboBox x:Name="LanguageSelect" Width="155" SelectedIndex="0">
         <ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
        <TextBlock x:Name="MachineLabel" Text="Профиль компьютера" Width="215"/>
        <TextBlock x:Name="SettingsMachineValue" Text="HOME" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="SettingsSafety" Text="Сбор запускается вместе с программой, данные остаются на этом компьютере. Управление GPU, драйвером и моделью отключено." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,22"/>
       <Button x:Name="CheckUpdatesButton" Content="Проверить обновления" HorizontalAlignment="Left"/>
       <TextBlock x:Name="UpdatesStatus" Text="Новые версии проверяются через официальный GitHub Release." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,9,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FooterLeft" Text="ЛОКАЛЬНО · ДАННЫЕ НЕ ОТПРАВЛЯЮТСЯ" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
   <TextBlock x:Name="FooterRight" Grid.Column="1" Text="v0.9 LAB · HOME / WORK" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
